          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "3a52cf04-209d-4bb6-984e-c25ad19fba1c",
      "name": "Add to CRM sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
