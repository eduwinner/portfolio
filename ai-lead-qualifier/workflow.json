{
  "id": "aiLeadQualifier01",
  "name": "AI Lead Qualifier (demo)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "1871e15e-5abc-4896-8a2f-1693717ac9a1",
      "name": "Lead webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "c38e62a9-4f56-46a8-a286-cadb8f65e405"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Normalize and validate the incoming lead, then build the AI request.\nconst body = $json.body ?? $json;\nconst clean = (v) => String(v ?? '').trim();\n\nconst lead = {\n  received_at: new Date().toISOString(),\n  name: clean(body.name),\n  email: clean(body.email).toLowerCase(),\n  company: clean(body.company),\n  website: clean(body.website),\n  budget: clean(body.budget),\n  message: clean(body.message).slice(0, 2000),\n};\n\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(lead.email)) {\n  throw new Error('Invalid email address');\n}\n\nconst prompt = `You qualify inbound leads for a software agency that builds mobile apps, APIs and automations.\nScore the lead from 0 to 100 (budget fit, clarity of need, urgency, company legitimacy).\nReturn ONLY a JSON object with keys:\n\"score\" (number), \"category\" (\"hot\" | \"warm\" | \"cold\" | \"spam\"),\n\"summary\" (one sentence), \"suggested_reply\" (2-3 friendly sentences in the lead's language).\n\nLead:\nName: ${lead.name}\nCompany: ${lead.company}\nWebsite: ${lead.website}\nBudget: ${lead.budget}\nMessage: ${lead.message}`;\n\nlead.aiRequest = {\n  model: 'claude-haiku-5-5',\n  max_tokens: 400,\n  messages: [{ role: 'user', content: prompt }],\n};\n\nreturn { json: lead };\n"
      },
      "id": "34a8ccf4-8d84-44e9-8f05-76a6ccc4014f",
      "name": "Normalize lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.aiRequest) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "3546271d-f405-4428-82ca-0c84e70ff96b",
      "name": "AI: score lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Merge the AI verdict with the lead. Falls back to \"review\" if the AI call failed.\nconst lead = { ...$('Normalize lead').item.json };\ndelete lead.aiRequest;\n\nlet ai = {\n  score: 0,\n  category: 'review',\n  summary: 'AI response unavailable - review manually',\n  suggested_reply: '',\n};\n\ntry {\n  const text = $json.content?.[0]?.text ?? '';\n  const match = text.match(/\\{[\\s\\S]*\\}/);\n  if (match) ai = { ...ai, ...JSON.parse(match[0]) };\n} catch (error) {\n  // keep fallback\n}\n\nconst score = Math.max(0, Math.min(100, Number(ai.score) || 0));\n\nreturn {\n  json: {\n    ...lead,\n    score,\n    category: ai.category,\n    summary: ai.summary,\n    suggested_reply: ai.suggested_reply,\n  },\n};\n"
      },
      "id": "69567a32-b457-4825-8665-dca613929180",
      "name": "Parse AI result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
