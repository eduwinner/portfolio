        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: `:fire: *Hot lead* (${$('Parse AI result').item.json.score}/100) - ${$('Parse AI result').item.json.name} from ${$('Parse AI result').item.json.company}\\n${$('Parse AI result').item.json.summary}\\nEmail: ${$('Parse AI result').item.json.email}` }) }}",
        "options": {}
      },
